{
  "sensetime": {
    "adapter": "html",
    "feed": "https://www.sensetime.com/cn/news",
    "linkPattern": "/(?:news|blog|articles?|posts?|research|insights|content|info)/.+|/\\d{4}/\\d{2}/"
  },
  "information": {
    "adapter": "rss",
    "feed": "https://www.theinformation.com/feed"
  },
  "moonshot": {
    "website": "https://www.kimi.com/en/blog/",
    "feed": "https://www.kimi.com/en/blog/",
    "adapter": "kimi",
    "language": "en",
    "notice": "官方研究博客；文章标题、日期与原文入口"
  },
  "bytedance": {
    "feed": "https://seed.bytedance.com/zh/",
    "adapter": "seed-list",
    "notice": "Seed 官网最新动态；不等于字节全部业务"
  },
  "stepfun": {
    "website": "https://www.stepfun.com/news",
    "feed": "https://www.stepfun.com/news",
    "adapter": "stepfun",
    "notice": "官网公开新闻数据；自动定位当前数据文件，不执行网页脚本"
  },
  "latepost": {
    "website": "https://www.latepost.com/",
    "feed": "https://www.latepost.com/news/get-news-data",
    "adapter": "latepost-api",
    "linkPattern": "^/news/dj_detail$",
    "maxArticles": 6,
    "notice": "公开新闻列表接口＋文章页原始发布日期"
  },
  "jazzyear": {
    "feed": "https://www.jazzyear.com/",
    "adapter": "html",
    "linkPattern": "^/article_info\\.html$",
    "maxArticles": 12
  },
  "techweb": {
    "feed": "https://www.techweb.com.cn/rss/hotnews.xml",
    "adapter": "rss",
    "notice": "官网订阅中心公布的每日热点 RSS；筛选 AI 相关内容"
  },
  "cas": {
    "feed": "https://ia.cas.cn/",
    "adapter": "html",
    "linkPattern": "^/xwzx/(?:ttxw|kyjz)/.*\\.html$",
    "notice": "自动化所官方科研动态；尚非模式识别实验室独立源"
  },
  "cadcg": {
    "feed": "http://www.cad.zju.edu.cn/feed",
    "adapter": "rss",
    "filterAI": true
  },
  "acl": {
    "feed": "https://www.aclweb.org/portal/?q=rss.xml",
    "adapter": "rss",
    "notice": "ACL 官方 RSS；最近记录日期以原文为准，不代表今年所有会议"
  },
  "naacl": {
    "website": "https://naacl.org/",
    "feed": "https://naacl.org/",
    "adapter": "naacl-news",
    "notice": "官方新闻列表；旧 RSS 停留于 2021 年，改用带日期的公告链接"
  },
  "contrary": {
    "feed": "https://research.contrary.com/",
    "adapter": "html",
    "linkPattern": "^/report/[^/]+$"
  },
  "semantic": {
    "feed": "https://api.semanticscholar.org/graph/v1/paper/search/bulk?query=artificial%20intelligence&fields=title,url,publicationDate,abstract&sort=publicationDate:desc",
    "adapter": "semantic",
    "language": "en",
    "notice": "公开论文检索 API；AI 关键词结果，非平台全量"
  },
  "aipapers": {
    "feed": "https://aipapers.ai/blogs",
    "adapter": "aipapers-list",
    "notice": "公开学术简报标题、日期与链接，内容为二次整理"
  },
  "xinzhiyuan": {
    "website": "https://www.aiera.com.cn/",
    "feed": "https://www.aiera.com.cn/asi-articles.html",
    "adapter": "aiera",
    "filterAI": false,
    "notice": "已更正官网；公开文章目录标题、日期与摘要"
  },
  "paperswithcode": {
    "notice": "原域名当前跳转 Hugging Face Papers；本站已另接 HF 每日论文，不重复计数"
  },
  "mmlab": {
    "notice": "官网公开新闻页较旧，未作为持续更新源启用"
  },
  "jiqizhixin": {
    "adapter": "jiqi-list",
    "feed": "https://www.jiqizhixin.com/industry",
    "notice": "官方公开产业报道列表：标题、原始日期、链接；不读取需登录的文章正文。"
  },
  "tencent": {
    "website": "https://hunyuan.tencent.com/blog",
    "feed": "https://api.hunyuan.tencent.com/api/blog/publicList",
    "adapter": "tencent-blog",
    "notice": "混元官方公开研究博客接口；不等于腾讯全部业务"
  },
  "pku-wang": {
    "feed": "https://www.wict.pku.edu.cn/",
    "adapter": "html",
    "linkPattern": "^/xwgg/xwdt/\\d{4}/[^/]+\\.htm$",
    "maxArticles": 8,
    "filterAI": true,
    "notice": "王选所官网动态，筛选 AI 相关研究"
  },
  "thu-dai": {
    "name": "清华 · 成像与智能技术实验室",
    "website": "https://media.au.tsinghua.edu.cn/cn/xwtz/xw.htm",
    "feed": "https://media.au.tsinghua.edu.cn/cn/xwtz/xw.htm",
    "adapter": "html",
    "linkPattern": "/info/1016/\\d+\\.htm$",
    "notice": "戴琼海相关实验室官方新闻"
  },
  "emnlp": {
    "website": "https://2026.emnlp.org/",
    "feed": "https://2026.emnlp.org/",
    "adapter": "emnlp-news",
    "notice": "EMNLP 2026 官方公告；后续届次需更新入口"
  },
  "pku-lin": {
    "website": "https://www.ai.pku.edu.cn/kxyj1/tyrgznyjs/jqxxyznkxllyjzx.htm",
    "notice": "已确认林宙辰相关研究中心，当前为机构介绍页，尚无独立更新源"
  },
  "baidu": {
    "adapter": "baidu-news",
    "website": "https://ai.baidu.com/support/news",
    "feed": "https://ai.baidu.com/support/news",
    "notice": "百度 AI 开放平台上线快报；覆盖官方产品更新，不等同百度所有新闻或研究院博客。"
  },
  "sacra": {
    "notice": "官方研究目录动态加载；单篇公开研究可读，但未确认持续列表入口。官方 News API 需申请访问，未用产品博客代替研究。"
  },
  "nvresearch": {
    "adapter": "rss",
    "website": "https://blogs.nvidia.com/blog/tag/nvidia-research/",
    "feed": "https://blogs.nvidia.com/blog/tag/nvidia-research/feed/",
    "notice": "NVIDIA 官方研究专题博客；不等同独立论文目录。与 NVIDIA 主博客按同一发布者计数。"
  },
  "36kr": {
    "website": "https://www.36kr.com/",
    "feed": "https://36kr.com/feed",
    "adapter": "rss",
    "uncompressed": true,
    "readerHeaders": true,
    "notice": "官方 RSS 中心当前 HTTPS 地址；需取得有效 RSS 响应后才计为接通。"
  },
  "venturebeat": {
    "readerHeaders": true,
    "notice": "与用户 Dify 一致的官方 AI 专栏 RSS；当前返回 HTTP 429 访问验证页，尚未稳定接通"
  },
  "sjtu-ai": {
    "name": "上海交大 · 人工智能学院",
    "adapter": "sjtu-list",
    "website": "https://soai.sjtu.edu.cn/cn/news/kydt",
    "feed": "https://soai.sjtu.edu.cn/cn/news/kydt",
    "notice": "官方学院科研动态；按官网发布日期采集，原文可能链接至公众号，不读取公众号正文。"
  },
  "sjtu-lu": {
    "notice": "学院科研动态已在“上海交大 · 人工智能学院”采集，部分含卢策吾团队；尚未建立团队独立更新入口。"
  },
  "ccl": {
    "adapter": "rss",
    "website": "https://cips-cl.org/",
    "feed": "https://cips-cl.org/?feed=rss2",
    "language": "zh",
    "notice": "中国中文信息学会计算语言学专委会官方 RSS；记录公告发布日期，不将会议日期当发布时间。"
  },
  "36kr-flashes": {
    "feed": "https://36kr.com/feed-newsflash",
    "notice": "官方快讯 RSS；与综合源按发布者合并计数，访问结果以最近检查为准。"
  },
  "sail": {
    "adapter": "github-posts",
    "feed": "https://api.github.com/repos/StanfordVL/sail-blog/contents/_posts?ref=source",
    "repositoryPage": "https://github.com/StanfordVL/sail-blog",
    "repositoryBranch": "source",
    "rawPrefix": "https://raw.githubusercontent.com/StanfordVL/sail-blog/source/_posts/",
    "maxArticles": 5,
    "notice": "官网 RSS 访问异常，改读实验室官方 GitHub 博客源文件；日期取稿件字段/文件名，原文链接指向官方仓库，不把旧备用 RSS 当实时数据。"
  },
  "scholar": {
    "notice": "官方说明不提供批量访问；保留检索入口。论文采集使用 arXiv、Semantic Scholar、HF，不计作 Google Scholar 接通。"
  },
  "thu-keip": {
    "name": "清华 · KEG 知识工程实验室",
    "website": "https://keg.cs.tsinghua.edu.cn/",
    "notice": "截图 KEIP 名称核对为 KEG；官网为客户端页面，尚未取得可持续新闻更新入口。"
  },
  "waica": {
    "name": "WAIC 世界人工智能大会",
    "website": "https://www.worldaic.com.cn/",
    "notice": "截图 WAICA 名称核对为 WAIC；官网新闻动态加载，独立新闻采集尚未接通。"
  }
}
